# --- Database -------------------------------------------------------------
# Local development: leave DATABASE_URL unset — the portal uses a local SQLite
# file (data/portal.sqlite) and auto-seeds demo data on first run.
#
# Vercel / production: create a Postgres database (Vercel Postgres, Neon,
# Supabase...) and set the connection string. Schema and demo seed are applied
# automatically on first request.
# DATABASE_URL=postgres://user:password@host:5432/campaign_portal

# --- Auth -----------------------------------------------------------------
# Secret used to sign session cookies. REQUIRED in production — generate with:
#   openssl rand -hex 32
SESSION_SECRET=change-me-in-production

# Optional: override the bootstrap admin created on first run (default admin / Admin123!)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=Admin123!
